# is what CI and contributors without the archive render from.
/app/data/generated/

# The downloadable sheets, which belong to the content repository and are
# copied in by the Docker build from the content image. Committing them here
# too would be a second copy of two megabytes of somebody else's artwork, kept
# in step by hand. Populate a checkout with:
#
#   cp ../sw5e-database/assets/resource/*.pdf public/resources/
/public/resources/
